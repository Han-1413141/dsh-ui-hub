{
  "name": "dsh-ui-hub",
  "version": "0.1.0",
  "description": "Find, show/hide and arrange plugin controls in DeepSeek Harness Desktop and Web, with layout backup and restore.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale/*.json",
    "docs/*.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-ui-hub",
    "summary": "搜索、开关和整理插件控件，支持桌面端与 Web，可导出和恢复布局。",
    "categories": [
      "Web UI",
      "布局",
      "工具"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": []
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.6",
      "node": ">=20"
    },
    "permissions": {}
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Han-1413141/dsh-ui-hub.git"
  },
  "homepage": "https://github.com/Han-1413141/dsh-ui-hub#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "ui",
    "layout",
    "widget",
    "collision",
    "toggle",
    "position"
  ],
  "license": "MIT",
  "scripts": {
    "test": "python -X utf8 test/verify.py && python -X utf8 test/verify_compat.py && python -X utf8 test/verify_layout.py && python -X utf8 test/verify_visibility.py",
    "test:runtime": "node test/runtime-smoke.mjs"
  }
}
